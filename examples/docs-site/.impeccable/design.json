  "narrative": {
    "northStar": "可以照着做的手册",
    "overview": "继承现有聊天 SDK 的工作台语言，把阅读和操作放在同一条路径上。白底与深蓝文字适合用户在明亮桌面环境下对照终端操作，深色模式满足另一种阅读环境。标题、分隔线和实际内容构成页面，不依靠营销插画或装饰卡片。",
    "keyCharacteristics": [
      "先给下一步，再给精确接口。",
      "阅读层级清楚，长内容可以定位和复制。",
      "文章导航与聊天状态彼此独立。"
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "蓝色代表可操作或当前选中，不代表产品能力已经验证。",
        "section": "colors"
      },
      {
        "name": "The Keep Your Place Rule",
        "body": "页面内导航保留聊天实例，询问本文保留正文位置和未发送草稿；浏览器返回恢复已有阅读位置。",
        "section": "layout"
      }
    ],
    "dos": [
      "每个入门步骤说明操作与成功标志。",
      "让表格和代码在自己的区域滚动。",
      "保留清楚的焦点样式和可访问名称。",
      "使用现有 SDK 的公开入口和主题配置。"
    ],
    "donts": [
      "不把本机配置、预设模型或开发状态写成面向所有用户的事实。",
      "不在正文中添加与任务无关的装饰标签或大面积背景效果。",
      "不把模型输出当作可执行 HTML。",
      "不把尚未执行的验证写成通过。"
    ]
  }
